#include <ESP8266WiFi.h>
#include <WiFiClientSecure.h>
#include <ESP8266HTTPClient.h>
#include <ArduinoJson.h>

const char* ssid     = "EDUARDO HOST";
const char* password = "redeeduardo";

const char* url = "https://preteen-driving-echo.ngrok-free.dev/api/dados/6";

// ---------------------------------------------------------
// Lê uma linha inteira da Serial (até '\n') e converte em float
// Retorna true se conseguiu ler algo válido dentro do timeout
// ---------------------------------------------------------
bool lerLinhaSerial(float &valor, unsigned long timeoutMs) {
  unsigned long inicio = millis();
  String linha = "";

  while (millis() - inicio < timeoutMs) {
    while (Serial.available() > 0) {
      char c = Serial.read();
      if (c == '\n') {
        linha.trim();
        if (linha.length() > 0) {
          valor = linha.toFloat();
          return true;
        }
      } else if (c != '\r') {
        linha += c;
      }
    }
  }
  return false;
}

// ---------------------------------------------------------
// Lê um valor do UNO e responde com o caractere de confirmação
// ---------------------------------------------------------
bool receberValor(float &valor, char confirmacao, unsigned long timeoutMs) {
  if (!lerLinhaSerial(valor, timeoutMs)) {
    Serial.print("Timeout esperando confirmacao '");
    Serial.print(confirmacao);
    Serial.println("'");
    return false;
  }
  Serial.print(confirmacao);   // handshake: avisa o UNO que recebeu
  return true;
}

// ---------------------------------------------------------
// Monta o JSON
// ---------------------------------------------------------
String montarJson(float temperatura, float umidade, float luzSolar) {
  StaticJsonDocument<200> doc;
  doc["temperatura"] = temperatura;
  doc["umidade"]     = umidade;
  doc["luzSolar"]    = luzSolar;

  String json;
  serializeJson(doc, json);
  return json;
}

// ---------------------------------------------------------
// Envia o JSON via PUT (agora chamada dentro do loop)
// ---------------------------------------------------------
void enviarDados(const String& json) {
  WiFiClientSecure client;
  client.setInsecure();
  client.setTimeout(15000);

  HTTPClient http;
  http.setTimeout(15000);

  if (!http.begin(client, url)) {
    Serial.println("FALHA ao iniciar HTTPClient!");
    return;
  }

  http.addHeader("Content-Type", "application/json");
  http.addHeader("ngrok-skip-browser-warning", "true");

  int httpCode = http.PUT(json);

  Serial.print("HTTP code: ");
  Serial.println(httpCode);

  if (httpCode > 0) {
    Serial.println(http.getString());
  } else {
    Serial.print("Erro: ");
    Serial.println(http.errorToString(httpCode));
  }

  http.end();
}

// ---------------------------------------------------------
void setup() {
  Serial.begin(9600);
  delay(1000);

  WiFi.begin(ssid, password);
  Serial.print("Conectando ao Wi-Fi");
  while (WiFi.status() != WL_CONNECTED) {
    delay(500);
    Serial.print(".");
  }
  Serial.println();
  Serial.print("Wi-Fi OK. IP: ");
  Serial.println(WiFi.localIP());
}

// ---------------------------------------------------------
void loop() {
  // Se o Wi-Fi caiu, tenta reconectar antes de enviar
  if (WiFi.status() != WL_CONNECTED) {
    Serial.println("Wi-Fi caiu, reconectando...");
    WiFi.reconnect();
    delay(2000);
    return;
  }

  float luz, umidade, temperatura;

  // Mesma ordem do UNO: LDR -> umidade -> temperatura
  if (!receberValor(luz,         '1', 6000)) return;
  if (!receberValor(umidade,     '2', 6000)) return;
  if (!receberValor(temperatura, '3', 6000)) return;

  String json = montarJson(temperatura, umidade, luz);
  enviarDados(json);
}
