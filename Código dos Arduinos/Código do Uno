#include <OneWire.h>
#include <DallasTemperature.h>

// -------- Sensor de umidade do solo --------
const int pinoUmidade = A0;

// -------- LDR (fotoresistor) --------
const int ldr = A2;

// -------- DS18B20 --------
const int pinoDados = 2;
OneWire oneWire(pinoDados);
DallasTemperature sensores(&oneWire);

// -------- Variáveis de controle --------
float temperatura = 0;
int valorLDR = 0;
int umidade = 0;
int envio = 0;
int dump = 0;
int looping = 1;
int erro = 0;


// ================= Funções dos sensores =================

int lerLDR() {
  return analogRead(ldr);
}

int lerUmidade() {
  return analogRead(pinoUmidade);
}

float lerDS18B20() {
  sensores.requestTemperatures();
  return sensores.getTempCByIndex(0);
}

// ================= Envio com handshake =================
// Envia o valor via Serial e aguarda o caractere de confirmação do ESP8266
void enviarValor(float valor, int confirmacao, unsigned long timeoutMs, int &erro) {
  envio = 0;
  if (erro == 1){

  } else {
    Serial.println(valor);
    unsigned long inicio = millis();
    while (envio == 0) {
     if (Serial.available() > 0) {
        dump = Serial.read();
       if (dump == confirmacao) {
         envio = 1;
       } else {
         if (dump == 53){
           digitalWrite(4, HIGH);
           envio = 1;
           erro = 1;
         }
       }
     }
     delay(50);
     if (millis() - inicio > timeoutMs) {
        erro = 49;
        digitalWrite(4, HIGH);
        break; 
     }   // <- proteção
      delay(50);
    }
  }



}

// ================= Setup =================

void setup() {
  Serial.begin(9600);
  sensores.begin();
  pinMode(ldr, INPUT);
  pinMode(pinoUmidade, INPUT);
  digitalWrite(3, HIGH);
  looping = 1;
  // ascender o led de erro até receber algum input
  while (looping == 1){
    if (Serial.available() > 0) {
      dump = Serial.read();
      looping = 0;
    }
  }
  digitalWrite(3, LOW);
  erro = 0;
}
// ================= Loop =================

void loop() {
  if(erro == 1){
    
  }
  else {
    // --- LDR ---
    valorLDR = lerLDR();
    enviarValor(valorLDR, 49, 30000, erro);

   // --- Umidade do solo ---
   umidade = lerUmidade();
   enviarValor(umidade, 50, 30000, erro);

    // --- DS18B20 ---
   temperatura = lerDS18B20();
   enviarValor(temperatura, 51, 30000, erro);

   delay(5000);
  }

}
